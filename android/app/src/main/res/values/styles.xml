<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/jarvis_cyan</item>
        <item name="android:navigationBarColor">@color/jarvis_bg</item>
        <item name="android:statusBarColor">@color/jarvis_bg</item>
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="JarvisPanelTheme" parent="android:style/Theme.Material.Light">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/jarvis_cyan_dim</item>
        <item name="android:navigationBarColor">@color/jarvis_bg</item>
        <item name="android:statusBarColor">@color/jarvis_bg_panel</item>
    </style>
</resources>
