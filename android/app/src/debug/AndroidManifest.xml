<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver android:name="com.jarvis.mobile.assistant.JarvisAssistantTestReceiver" android:exported="true"><intent-filter><action android:name="com.jarvis.mobile.DEBUG_SHOW_ASSISTANT" /></intent-filter></receiver>
        <receiver android:name="com.jarvis.mobile.actions.JarvisEmailTestReceiver" android:exported="true"><intent-filter><action android:name="com.jarvis.mobile.DEBUG_TEST_EMAIL" /></intent-filter></receiver>
        <receiver android:name="com.jarvis.mobile.JarvisDiagnosticsTestReceiver" android:exported="true"><intent-filter><action android:name="com.jarvis.mobile.DEBUG_SHOW_DIAGNOSTICS" /></intent-filter></receiver>
        <receiver android:name="com.jarvis.mobile.brain.providers.OpenAiCompatibleProviderTestReceiver" android:exported="true"><intent-filter><action android:name="com.jarvis.mobile.DEBUG_TEST_LOCAL_CORTEX" /></intent-filter></receiver>
        <receiver android:name="com.jarvis.mobile.brain.providers.LocalAssistantIntelligenceTestReceiver" android:exported="true"><intent-filter><action android:name="com.jarvis.mobile.DEBUG_TEST_ASSISTANT_INTELLIGENCE" /></intent-filter></receiver>
        <receiver android:name="com.jarvis.mobile.brain.AndroidExternalResearchGatewayTestReceiver" android:exported="true"><intent-filter><action android:name="com.jarvis.mobile.DEBUG_TEST_EXTERNAL_RESEARCH" /></intent-filter></receiver>
        <receiver android:name="com.jarvis.mobile.remote.RemoteGoalStateTestReceiver" android:exported="true"><intent-filter><action android:name="com.jarvis.mobile.DEBUG_SEED_REMOTE_GOAL" /></intent-filter></receiver>

        <!-- Debug-only overrides: emulator CI may launch real production secondary screens directly. -->
        <activity android:name="com.jarvis.mobile.CommandsActivity" android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.jarvis.mobile.NotesActivity" android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.jarvis.mobile.SettingsActivity" android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.jarvis.mobile.DeveloperSettingsActivity" android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.jarvis.mobile.DiagnosticsActivity" android:exported="true" tools:replace="android:exported" />

        <activity android:name="com.jarvis.mobile.actions.JarvisEmailCaptureActivity" android:exported="true" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter><action android:name="android.intent.action.SENDTO" /><category android:name="android.intent.category.DEFAULT" /><data android:scheme="mailto" /></intent-filter>
        </activity>
        <activity android:name="com.jarvis.mobile.actions.JarvisSmsCaptureActivity" android:label="JARVIS SMS Capture" android:exported="true" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter><action android:name="android.intent.action.SENDTO" /><category android:name="android.intent.category.DEFAULT" /><data android:scheme="smsto" /></intent-filter>
        </activity>
    </application>
</manifest>
