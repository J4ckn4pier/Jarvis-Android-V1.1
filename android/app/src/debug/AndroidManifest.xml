<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="com.jarvis.mobile.assistant.JarvisAssistantTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jarvis.mobile.DEBUG_SHOW_ASSISTANT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jarvis.mobile.actions.JarvisEmailTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jarvis.mobile.DEBUG_TEST_EMAIL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jarvis.mobile.JarvisDiagnosticsTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jarvis.mobile.DEBUG_SHOW_DIAGNOSTICS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jarvis.mobile.brain.providers.OpenAiCompatibleProviderTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jarvis.mobile.DEBUG_TEST_LOCAL_CORTEX" />
            </intent-filter>
        </receiver>

        <!-- Debug-only override: emulator CI may launch the real production diagnostics Activity directly.
             The main/release manifest keeps this Activity non-exported. -->
        <activity
            android:name="com.jarvis.mobile.DiagnosticsActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name="com.jarvis.mobile.actions.JarvisEmailCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mailto" />
            </intent-filter>
        </activity>
    </application>
</manifest>
